default_platform(:android)

platform :android do
  desc "Build debug APK for ComposeApp"
  lane :build_debug do
    gradle(task: "clean :composeApp:assembleDebug")
  end

  desc "Build release APK for ComposeApp"
  lane :build_release do
    gradle(task: "clean :composeApp:assembleRelease")
  end

  desc "Run all tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Run unit tests for shared and composeApp"
  lane :unit_tests do
    gradle(task: ":shared:testDebugUnitTest :composeApp:testDebugUnitTest")
  end

  desc "Deploy to Firebase App Distribution"
  lane :deploy_firebase do
    apk_path = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH] || "composeApp/build/outputs/apk/release/composeApp-release.apk"
    
    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID"],
      apk_path: apk_path,
      groups: "testers",
      release_notes: "KMP Build: #{ENV['GITHUB_SHA'] || `git rev-parse --short HEAD`.strip}"
    )
  end

  desc "Increment version code in composeApp"
  lane :bump_version_code do
    path = '../composeApp/build.gradle.kts'
    replace = lambda { |file, old, new|
      text = File.read(file)
      File.write(file, text.gsub(old, new))
    }
    
    current_version_code = File.read(path).match(/versionCode = (\d+)/)[1].to_i
    new_version_code = current_version_code + 1
    
    replace.call(path, "versionCode = #{current_version_code}", "versionCode = #{new_version_code}")
    
    UI.success("Version code bumped from #{current_version_code} to #{new_version_code}")
  end
end

