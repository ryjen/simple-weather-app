default_platform(:android)

platform :android do
  desc "Build debug APK for ComposeApp"
  lane :build_debug do
    gradle(task: "clean :composeApp:assembleDebug")
  end

  desc "Run unit tests for shared and composeApp"
  lane :unit_tests do
    gradle(task: ":shared:testDebugUnitTest :composeApp:testDebugUnitTest")
  end

  desc "Deploy to Firebase App Distribution"
  lane :deploy_firebase do
    apk_path = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH] || "composeApp/build/outputs/apk/debug/composeApp-debug.apk"
    
    firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID"],
      apk_path: apk_path,
      groups: "testers",
      release_notes: "KMP Build: #{ENV['GITHUB_SHA'] || `git rev-parse --short HEAD`.strip}"
    )
  end
end

platform :ios do
  desc "Run shared iOS unit tests"
  lane :shared_tests do
    gradle(
      gradle_path: "./gradlew",
      task: ":shared:iosSimulatorArm64Test"
    )
  end

  desc "Build iOS app"
  lane :build do
    # Requires an active macOS environment and Xcode project setup
    # gym(scheme: "iosApp", project: "iosApp/iosApp.xcodeproj")
    UI.message("iOS build requires a macOS environment with Xcode.")
  end
end
